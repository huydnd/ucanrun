[
 {
  "group": "GitHub",
  "title": "Xem repo của tôi",
  "secrets": [
   "github_token"
  ],
  "hint": "Fine-grained token, quyền đọc Metadata.",
  "profile": {
   "name": "github-list-repos",
   "description": "Liệt kê repo GitHub",
   "risk": "low",
   "http": {
    "method": "GET",
    "url": "https://api.github.com/user/repos?per_page=100&sort=updated",
    "headers": {
     "Authorization": "Bearer {{secret:github_token}}",
     "Accept": "application/vnd.github+json"
    }
   }
  },
  "title_en": "List my repos",
  "hint_en": "Fine-grained token with Metadata read access."
 },
 {
  "group": "GitHub",
  "title": "Tạo issue",
  "secrets": [
   "github_token"
  ],
  "hint": "Cần quyền ghi Issues.",
  "profile": {
   "name": "github-create-issue",
   "description": "Tạo issue trên GitHub",
   "risk": "low",
   "params": [
    {
     "name": "owner",
     "pattern": "[A-Za-z0-9-]{1,39}",
     "required": true
    },
    {
     "name": "repo",
     "pattern": "[a-z0-9._-]{1,64}",
     "required": true
    },
    {
     "name": "title",
     "pattern": "[\\p{L}\\p{N} ._,:@/-]{1,200}",
     "required": true
    }
   ],
   "http": {
    "method": "POST",
    "url": "https://api.github.com/repos/{{owner}}/{{repo}}/issues",
    "headers": {
     "Authorization": "Bearer {{secret:github_token}}",
     "Accept": "application/vnd.github+json",
     "Content-Type": "application/json"
    },
    "body": "{\"title\":\"{{title}}\"}"
   }
  },
  "title_en": "Create an issue",
  "hint_en": "Needs Issues write access."
 },
 {
  "group": "Gitea",
  "title": "Xem repo",
  "secrets": [
   "gitea_token"
  ],
  "hint": "Token Gitea, quyền đọc repository. Sửa địa chỉ cho đúng máy chủ của bạn.",
  "profile": {
   "name": "gitea-list-repos",
   "description": "Liệt kê repo Gitea",
   "risk": "low",
   "http": {
    "method": "GET",
    "url": "https://gitea.example.com/api/v1/user/repos?limit=50",
    "headers": {
     "Authorization": "token {{secret:gitea_token}}"
    }
   }
  },
  "custom": true,
  "title_en": "List repos",
  "hint_en": "Gitea token with repository read access. Edit the server URL."
 },
 {
  "group": "Gitea",
  "title": "Tạo repo private",
  "secrets": [
   "gitea_token"
  ],
  "hint": "Cần quyền ghi repository. Sửa địa chỉ cho đúng máy chủ của bạn.",
  "profile": {
   "name": "gitea-create-repo",
   "description": "Tạo repo private trên Gitea",
   "risk": "low",
   "params": [
    {
     "name": "repo",
     "pattern": "[a-z0-9._-]{1,64}",
     "required": true
    }
   ],
   "http": {
    "method": "POST",
    "url": "https://gitea.example.com/api/v1/user/repos",
    "headers": {
     "Authorization": "token {{secret:gitea_token}}",
     "Content-Type": "application/json"
    },
    "body": "{\"name\":\"{{repo}}\",\"private\":true}"
   }
  },
  "custom": true,
  "title_en": "Create a private repo",
  "hint_en": "Needs repository write access. Edit the server URL."
 },
 {
  "group": "Cloudflare",
  "title": "Xem domain",
  "secrets": [
   "cloudflare_token"
  ],
  "hint": "API token, quyền Zone Read.",
  "profile": {
   "name": "cloudflare-list-zones",
   "description": "Liệt kê domain Cloudflare",
   "risk": "low",
   "http": {
    "method": "GET",
    "url": "https://api.cloudflare.com/client/v4/zones",
    "headers": {
     "Authorization": "Bearer {{secret:cloudflare_token}}"
    }
   }
  },
  "title_en": "List domains",
