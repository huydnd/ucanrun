 },
 {
  "group": "Máy chủ",
  "title": "Khởi động lại dịch vụ qua SSH",
  "secrets": [
   "ssh_key",
   "sudo_password"
  ],
  "custom": true,
  "hint": "Cần image exec. Sửa máy chủ và danh sách dịch vụ. Xem docs/ssh-sudo.md.",
  "profile": {
   "name": "ssh-restart-service",
   "description": "Khởi động lại một dịch vụ trên máy chủ",
   "risk": "high",
   "timeout_sec": 60,
   "params": [
    {
     "name": "service",
     "pattern": "nginx|cron",
     "required": true
    }
   ],
   "exec": {
    "argv": [
     "/usr/bin/ssh",
     "-i",
     "id_key",
     "-o",
     "IdentitiesOnly=yes",
     "-o",
     "BatchMode=yes",
     "-o",
     "StrictHostKeyChecking=accept-new",
     "-o",
     "UserKnownHostsFile=known_hosts",
     "deploy@server.example.com",
     "sudo -S -p '' /usr/bin/systemctl restart {{service}}"
    ],
    "stdin": "{{secret:sudo_password}}",
    "files": {
     "id_key": "{{secret:ssh_key}}"
    }
   }
  },
  "title_en": "Restart a service over SSH",
  "hint_en": "Needs the exec image. Edit the server and services. See docs/ssh-sudo.md.",
  "group_en": "Servers"
 }
]