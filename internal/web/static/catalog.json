[
 {
  "service": {
   "name": "github",
   "title": "GitHub",
   "base_url": "https://api.github.com",
   "auth": {
    "type": "bearer",
    "secret": "github_token"
   },
   "headers": {
    "Accept": "application/vnd.github+json"
   }
  },
  "hint": "Fine-grained token. Cấp quyền theo hành động bạn bật.",
  "hint_en": "Fine-grained token, with the access the enabled actions need.",
  "actions": [
   {
    "title": "Xem repo của tôi",
    "title_en": "List my repos",
    "profile": {
     "name": "github-list-repos",
     "description": "Liệt kê repo GitHub",
     "risk": "low",
     "http": {
      "method": "GET",
      "url": "/user/repos?per_page=100&sort=updated"
     },
     "connection": "github"
    }
   },
   {
    "title": "Kiểm tra token",
    "title_en": "Check the token",
    "profile": {
     "name": "github-whoami",
     "description": "Xem tài khoản GitHub của token",
     "risk": "low",
     "auto_approve": true,
     "http": {
      "method": "GET",
      "url": "/user"
     },
     "connection": "github"
    }
   },
   {
    "title": "Tạo issue",
    "title_en": "Create an issue",
    "profile": {
     "name": "github-create-issue",
     "description": "Tạo issue trên GitHub",
     "risk": "low",
     "params": [
      {
       "name": "owner",
       "pattern": "[A-Za-z0-9-]{1,39}",
       "required": true
      },
      {
       "name": "repo",
       "pattern": "[a-z0-9._-]{1,64}",
       "required": true
      },
      {
       "name": "title",
       "pattern": "[\\p{L}\\p{N} ._,:@/-]{1,200}",
       "required": true
      }
     ],
     "http": {
      "method": "POST",
      "url": "/repos/{{owner}}/{{repo}}/issues",
      "headers": {
       "Content-Type": "application/json"
      },
      "body": "{\"title\":\"{{title}}\"}"
     },
     "connection": "github"
    }
   }
  ]
 },
 {
  "service": {
   "name": "gitea",
   "title": "Gitea",
   "base_url": "https://gitea.example.com/api/v1",
   "auth": {
    "type": "token",
    "secret": "gitea_token"
   }
  },
  "hint": "Sửa địa chỉ cho đúng máy chủ của bạn bằng Tuỳ chỉnh kết nối.",
  "hint_en": "Use Customize to set your server address.",
  "custom": true,
  "actions": [
   {
    "title": "Xem repo",
    "title_en": "List repos",
    "profile": {
     "name": "gitea-list-repos",
     "description": "Liệt kê repo Gitea",
     "risk": "low",
     "http": {
      "method": "GET",
      "url": "/user/repos?limit=50"
     },
     "connection": "gitea"
    }
   },
   {
    "title": "Tạo repo private",
    "title_en": "Create a private repo",
    "profile": {
     "name": "gitea-create-repo",
     "description": "Tạo repo private trên Gitea",
     "risk": "low",
     "params": [
      {
       "name": "repo",
       "pattern": "[a-z0-9._-]{1,64}",
       "required": true
      }
     ],
     "http": {
      "method": "POST",
      "url": "/user/repos",
      "headers": {
       "Content-Type": "application/json"
      },
      "body": "{\"name\":\"{{repo}}\",\"private\":true}"
     },
     "connection": "gitea"
    }
   }
  ]
 },
 {
  "service": {
   "name": "cloudflare",
   "title": "Cloudflare",
   "base_url": "https://api.cloudflare.com/client/v4",
   "auth": {
    "type": "bearer",
    "secret": "cloudflare_token"
   }
  },
  "hint": "API token. Zone Read để xem, Cache Purge để xoá cache.",
  "hint_en": "API token. Zone Read to list, Cache Purge to purge.",
  "actions": [
   {
    "title": "Xem domain",
    "title_en": "List domains",
    "profile": {
     "name": "cloudflare-list-zones",
     "description": "Liệt kê domain Cloudflare",
     "risk": "low",
     "http": {
      "method": "GET",
      "url": "/zones"
     },
     "connection": "cloudflare"
    }
   },
   {
    "title": "Xoá cache domain",
    "title_en": "Purge a domain cache",
    "profile": {
     "name": "cloudflare-purge-cache",
     "description": "Xoá toàn bộ cache một domain",
     "risk": "high",
     "params": [
      {
       "name": "zone_id",
       "pattern": "[0-9a-f]{32}",
       "required": true
      }
     ],
     "http": {
      "method": "POST",
      "url": "/zones/{{zone_id}}/purge_cache",
      "headers": {
       "Content-Type": "application/json"
      },
      "body": "{\"purge_everything\":true}"
     },
     "connection": "cloudflare"
    }
   }
  ]
 },
 {
  "service": {
   "name": "deepseek",
   "title": "DeepSeek",
   "base_url": "https://api.deepseek.com",
   "auth": {
    "type": "bearer",
    "secret": "deepseek_key"
   }
  },
  "hint": "API key DeepSeek.",
  "hint_en": "DeepSeek API key.",
  "actions": [
   {
    "title": "Xem số dư",
    "title_en": "Check balance",
    "profile": {
     "name": "deepseek-balance",
     "description": "Xem số dư DeepSeek",
     "risk": "low",
     "auto_approve": true,
     "http": {
      "method": "GET",
      "url": "/user/balance"
     },
     "connection": "deepseek"
    }
   }
  ]
 },
 {
  "service": {
   "name": "google-ai",
   "title": "Google AI",
   "base_url": "https://generativelanguage.googleapis.com/v1beta",
   "auth": {
    "type": "header",
    "header": "x-goog-api-key",
    "secret": "google_ai_key"
   }
  },
  "hint": "API key từ Google AI Studio.",
  "hint_en": "API key from Google AI Studio.",
  "actions": [
   {
    "title": "Xem model",
    "title_en": "List models",
    "profile": {
     "name": "google-ai-list-models",
     "description": "Liệt kê model Google AI",
     "risk": "low",
     "auto_approve": true,
     "http": {
      "method": "GET",
      "url": "/models"
     },
     "connection": "google-ai"
    }
   }
  ]
 },
 {
  "service": {
   "name": "notion",
   "title": "Notion",
   "base_url": "https://api.notion.com/v1",
   "auth": {
    "type": "bearer",
    "secret": "notion_token"
   },
   "headers": {
    "Notion-Version": "2022-06-28"
   }
  },
  "hint": "Internal integration token.",
  "hint_en": "Internal integration token.",
  "actions": [
   {
    "title": "Tìm trang",
    "title_en": "Search pages",
    "profile": {
     "name": "notion-search",
     "description": "Tìm trang Notion",
     "risk": "low",
     "params": [
      {
       "name": "query",
       "pattern": "[\\p{L}\\p{N} ._,:@/-]{1,200}",
       "required": true
      }
     ],
     "http": {
      "method": "POST",
      "url": "/search",
      "headers": {
       "Content-Type": "application/json"
      },
      "body": "{\"query\":\"{{query}}\"}"
     },
     "connection": "notion"
    }
   }
  ]
 },
 {
  "title": "Khởi động lại dịch vụ qua SSH",
  "title_en": "Restart a service over SSH",
  "hint": "Cần image exec. Sửa máy chủ và danh sách dịch vụ. Xem docs/ssh-sudo.md.",
  "hint_en": "Needs the exec image. Edit the server and services. See docs/ssh-sudo.md.",
  "custom": true,
  "actions": [
   {
    "title": "Khởi động lại dịch vụ",
    "title_en": "Restart a service",
    "profile": {
     "name": "ssh-restart-service",
     "description": "Khởi động lại một dịch vụ trên máy chủ",
     "risk": "high",
     "timeout_sec": 60,
     "params": [
      {
       "name": "service",
       "pattern": "nginx|cron",
       "required": true
      }
     ],
     "exec": {
      "argv": [
       "/usr/bin/ssh",
       "-i",
       "id_key",
       "-o",
       "IdentitiesOnly=yes",
       "-o",
       "BatchMode=yes",
       "-o",
       "StrictHostKeyChecking=accept-new",
       "-o",
       "UserKnownHostsFile=known_hosts",
       "deploy@server.example.com",
       "sudo -S -p '' /usr/bin/systemctl restart {{service}}"
      ],
      "stdin": "{{secret:sudo_password}}",
      "files": {
       "id_key": "{{secret:ssh_key}}"
      }
     }
    }
   }
  ]
 }
]