 },
 {
  "group": "Cloudflare",
  "title": "Xoá cache domain",
  "secrets": [
   "cloudflare_token"
  ],
  "hint": "Cần quyền Cache Purge. Yêu cầu TOTP.",
  "profile": {
   "name": "cloudflare-purge-cache",
   "description": "Xoá toàn bộ cache một domain",
   "risk": "high",
   "params": [
    {
     "name": "zone_id",
     "pattern": "[0-9a-f]{32}",
     "required": true
    }
   ],
   "http": {
    "method": "POST",
    "url": "https://api.cloudflare.com/client/v4/zones/{{zone_id}}/purge_cache",
    "headers": {
     "Authorization": "Bearer {{secret:cloudflare_token}}",
     "Content-Type": "application/json"
    },
    "body": "{\"purge_everything\":true}"
   }
  },
  "title_en": "Purge a domain cache",
  "hint_en": "Needs Cache Purge. Requires TOTP."
 },
